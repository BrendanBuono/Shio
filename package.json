{
  "name": "shio-engine",
  "version": "0.1.0",
  "description": "Shio, a small 2D HTML5 game engine written from scratch as a learning exercise",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sprites": "node scripts/make-placeholder-sprites.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
